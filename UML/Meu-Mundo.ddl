CREATE OR REPLACE VIEW MEU_MUNDO_CONSULTA.VW_DESENHOS ( COD_DESENHO, TITULO, TIPO, CAMINHO_PREVIEW, DATA_CRIACAO, DATA_ATUALIZACAO, COD_USUARIO, NOME_USUARIO, COD_IMAGEM, NOME_IMAGEM, IMAGEM_BASE ) AS
SELECT
    D.COD_DESENHO,
    D.TITULO,
    D.TIPO,
    D.CAMINHO_PREVIEW,
    D.DATA_CRIACAO,
    D.DATA_ATUALIZACAO,
    U.COD_USUARIO,
    U.NOME AS NOME_USUARIO,
    I.COD_IMAGEM,
    I.NOME AS NOME_IMAGEM,
    I.CAMINHO_IMAGEM AS IMAGEM_BASE
FROM TB_DESENHO D
INNER JOIN TB_USUARIO U
    ON U.COD_USUARIO = D.COD_USUARIO
LEFT JOIN TB_IMAGEM I
    ON I.COD_IMAGEM = D.COD_IMAGEM 
;



GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_DESENHOS TO MEU_MUNDO_APP 
;


GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_DESENHOS TO MEU_MUNDO_CONSULTA 
;

CREATE OR REPLACE VIEW MEU_MUNDO_CONSULTA.VW_ELEMENTOS_HISTORIA ( COD_HISTORIA_ELEMENTO, COD_HISTORIA, TITULO_HISTORIA, COD_ELEMENTO, NOME_ELEMENTO, TIPO, CAMINHO_IMAGEM, ORDEM ) AS
SELECT
    HE.COD_HISTORIA_ELEMENTO,
    H.COD_HISTORIA,
    H.TITULO AS TITULO_HISTORIA,
    E.COD_ELEMENTO,
    E.NOME AS NOME_ELEMENTO,
    E.TIPO,
    E.CAMINHO_IMAGEM,
    HE.ORDEM
FROM TB_HISTORIA_ELEMENTO HE
INNER JOIN TB_HISTORIA H
    ON H.COD_HISTORIA = HE.COD_HISTORIA
INNER JOIN TB_ELEMENTO_VISUAL E
    ON E.COD_ELEMENTO = HE.COD_ELEMENTO 
;



GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_ELEMENTOS_HISTORIA TO MEU_MUNDO_APP 
;


GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_ELEMENTOS_HISTORIA TO MEU_MUNDO_CONSULTA 
;

CREATE OR REPLACE VIEW MEU_MUNDO_CONSULTA.VW_HISTORIAS ( COD_HISTORIA, TITULO, DESCRICAO, DATA_CRIACAO, DATA_ATUALIZACAO, COD_USUARIO, NOME_USUARIO, EMAIL ) AS
SELECT
    H.COD_HISTORIA,
    H.TITULO,
    H.DESCRICAO,
    H.DATA_CRIACAO,
    H.DATA_ATUALIZACAO,
    U.COD_USUARIO,
    U.NOME AS NOME_USUARIO,
    U.EMAIL
FROM TB_HISTORIA H
INNER JOIN TB_USUARIO U
    ON U.COD_USUARIO = H.COD_USUARIO 
;



GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_HISTORIAS TO MEU_MUNDO_APP 
;


GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_HISTORIAS TO MEU_MUNDO_CONSULTA 
;

CREATE OR REPLACE VIEW MEU_MUNDO_CONSULTA.VW_MINHAS_PRODUCOES ( COD_PRODUCAO, COD_USUARIO, TITULO, TIPO_PRODUCAO, DATA_CRIACAO, CAMINHO_PREVIEW, COD_PRODUCAO_1, TIPO_PRODUCAO_1 ) AS
SELECT
    H.COD_HISTORIA AS COD_PRODUCAO,
    H.COD_USUARIO,
    H.TITULO,
    'HISTORIA' AS TIPO_PRODUCAO,
    H.DATA_CRIACAO,
    CAST(NULL AS VARCHAR2(500)) AS CAMINHO_PREVIEW
FROM TB_HISTORIA H

UNION ALL

SELECT
    D.COD_DESENHO AS COD_PRODUCAO,
    D.COD_USUARIO,
    D.TITULO,
    CASE
        WHEN D.TIPO = 'LIVRE' THEN 'DESENHO LIVRE'
        WHEN D.TIPO = 'COLORIDO' THEN 'IMAGEM COLORIDA'
    END AS TIPO_PRODUCAO,
    D.DATA_CRIACAO,
    D.CAMINHO_PREVIEW
FROM TB_DESENHO D 
;



GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_MINHAS_PRODUCOES TO MEU_MUNDO_APP 
;


GRANT SELECT 
ON MEU_MUNDO_CONSULTA.VW_MINHAS_PRODUCOES TO MEU_MUNDO_CONSULTA 
;

CREATE OR REPLACE VIEW MEU_MUNDO_CONSULTA.VW_USUARIOS ( COD_USUARIO, NOME, EMAIL, PERFIL, COD_RESPONSAVEL, DATA_CADASTRO ) AS
SELECT
    COD_USUARIO,
    NOME,
    EMAIL,
    PERFIL,
    COD_RESPONSAVEL,
    DATA_CADASTRO
FROM TB_USUARIO 
;



