<userDefinedSQL><![CDATA[SELECT
    H.COD_HISTORIA,
    H.TITULO,
    H.DESCRICAO,
    H.DATA_CRIACAO,
    H.DATA_ATUALIZACAO,
    U.COD_USUARIO,
    U.NOME AS NOME_USUARIO,
    U.EMAIL
FROM TB_HISTORIA H
INNER JOIN TB_USUARIO U
    ON U.COD_USUARIO = H.COD_USUARIO]]></userDefinedSQL>
