<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT
    HE.COD_HISTORIA_ELEMENTO,
    H.COD_HISTORIA,
    H.TITULO AS TITULO_HISTORIA,
    E.COD_ELEMENTO,
    E.NOME AS NOME_ELEMENTO,
    E.TIPO,
    E.CAMINHO_IMAGEM,
    HE.ORDEM
FROM TB_HISTORIA_ELEMENTO HE
INNER JOIN TB_HISTORIA H
    ON H.COD_HISTORIA = HE.COD_HISTORIA
INNER JOIN TB_ELEMENTO_VISUAL E
    ON E.COD_ELEMENTO = HE.COD_ELEMENTO]]></userDefinedSQL>
