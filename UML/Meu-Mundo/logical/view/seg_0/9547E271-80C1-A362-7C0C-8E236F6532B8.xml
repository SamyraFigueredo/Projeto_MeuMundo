<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT
    D.COD_DESENHO,
    D.TITULO,
    D.TIPO,
    D.CAMINHO_PREVIEW,
    D.DATA_CRIACAO,
    D.DATA_ATUALIZACAO,
    U.COD_USUARIO,
    U.NOME AS NOME_USUARIO,
    I.COD_IMAGEM,
    I.NOME AS NOME_IMAGEM,
    I.CAMINHO_IMAGEM AS IMAGEM_BASE
FROM TB_DESENHO D
INNER JOIN TB_USUARIO U
    ON U.COD_USUARIO = D.COD_USUARIO
LEFT JOIN TB_IMAGEM I
    ON I.COD_IMAGEM = D.COD_IMAGEM]]></userDefinedSQL>
